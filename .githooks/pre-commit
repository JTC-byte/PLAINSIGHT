#!/bin/sh
# Class F surface. Git history is the one store a crypto-shred cannot reach.
# A selector value committed here survives every retention mechanism below it.
#
# This runs the `make preflight` battery less the telemetry test, which CI runs
# as a step of its own. A gate enforced only in CI is enforced only after the
# thing it guards is already in the history.
#
# Step 8 added two validators and did not add their artifact modes here, which
# is a decision rather than an omission. Their artifact modes refuse while
# policy/subject-authorization.yaml, schema/subject-authorization.schema.json,
# policy/retention.yaml and conformance/retention/shred-roundtrip.yaml carry no
# dated row in doctrine/DOCTRINE_STATUS.md, so wiring one in would block every
# commit in this repository on a decision only the operator can make, including
# the commit that records it. The hook's job is narrower and it is already done
# below: stop a selector value from entering the one store nothing can clear.
# `--repo-scan --staged` is that check, reading the index rather than the
# working tree, and `make validate-kernel` runs the working-tree scan where a
# refusal can be read rather than blocking a commit.
#
# The application's tests under app/ are not run here either, by reading
# APP-R30 of 2026-10-28: they take about three minutes and guard runtime
# behaviour rather than what enters the history. The kernel gate, make test and
# CI's Application tests step run them.

set -e

python tools/validate_doctrine.py --quiet || {
  echo ""
  echo "pre-commit refused: the doctrine corpus is inconsistent."
  echo "  rule:  AGENTS.md > Documentation matrix"
  echo "  moves: fix the criterion, its pin-of-record row, or the cross-reference"
  echo "         named above, then commit again."
  exit 1
}

python tools/validate_hygiene.py --quiet || {
  echo ""
  echo "pre-commit refused: a tracked file breaks the housekeeping standard."
  echo "  rule:  CLAUDE.md section 4"
  echo "  moves: fix the line named above, or add the file to VOICE_EXEMPT in"
  echo "         tools/validate_hygiene.py with the reason it is exempt."
  exit 1
}

python tools/validate_layer_model.py --quiet || {
  echo ""
  echo "pre-commit refused: spec/layer-model.yaml is inconsistent with itself or with D6."
  echo "  rule:  AGENTS.md > Documentation matrix, CLAUDE.md > design gate 1"
  echo "  moves: fix the type, subtype, lineage or code named above, then commit again."
  exit 1
}

python tools/validate_ontology.py --quiet || {
  echo ""
  echo "pre-commit refused: ontology/selectors.yaml is inconsistent."
  echo "  rule:  PLAINSIGHT-FOUNDATION.md D2, AGENTS.md > Documentation matrix"
  echo "  moves: fix the selector, its matcher, its prohibition, or the entity"
  echo "         anchor named above, then commit again."
  exit 1
}

python tools/validate_cast.py --placeholder-scan --quiet || {
  echo ""
  echo "pre-commit refused: the cast draft is inconsistent, or carries a filled value while unsealed."
  echo "  rule:  AGENTS.md > Execution Limits, doctrine/SUBJECT_SELECTION.md SS-3"
  echo "  moves: restore the placeholder, or fill and seal the file as one act per synthetic/CAST.md section 8."
  exit 1
}

python tools/validate.py --kernel --quiet || {
  echo ""
  echo "pre-commit refused: a generated artifact is stale, or the conformance corpora do not grade."
  echo "  rule:  spec/layer-model.yaml header, CONFORMANCE.md section 3 rung 2, CLAUDE.md design gate 1"
  echo "  moves: run python tools/generate_pse.py and python tools/build_corpus.py to regenerate;"
  echo "         never edit schema/, policy/ or conformance/*.jsonl by hand; then commit again."
  exit 1
}

# Step 9. The register's entry list is derived from a diff of the PSE schema
# and zmeta-event-1.0, read from the sibling checkout ../ZMeta/zmeta-spec, so a
# schema change that moves the diff, or a stale rendering, refuses here rather
# than after the commit. Exit 2 means that checkout or another input is absent.
python tools/validate_divergence_register.py --quiet || {
  echo ""
  echo "pre-commit refused: the divergence register disagrees with the schema diff, or an input it reads is absent."
  echo "  rule:  docs/THE-GAMEPLAN.md Step 9, AGENTS.md section 1 and the Schema row of section 6"
  echo "  moves: fix the entry, pointer, pin, test_ref or line named above and re-render with"
  echo "         python tools/render_divergence_register.py; or check out zmeta-spec at"
  echo "         ../ZMeta/zmeta-spec as the refusal names; then commit again."
  exit 1
}

# Step 12. Every connector manifest against the manifest schema, the selector
# registry, both canaries, one refusal fixture per required input, SS-10's
# bystander declaration and the R7 stamp. connectors/sherlock/manifest.yaml was
# refused under MANIFEST_SELECTOR_PLATFORM at emits.0 on reading SH-R5 in
# connectors/sherlock/README.md, which blocked every commit, until the
# platform_from_item move of 2026-10-28 (MF-R17), built on the maintainer's
# instruction; whether that move stands is his decision, and reverting it
# returns this command and the next to refusing.
python tools/validate_manifest.py --all --quiet || {
  echo ""
  echo "pre-commit refused: a connector manifest, or a schema it is graded against, is refused."
  echo "  rule:  docs/PLAINSIGHT-design.md section 6.4, doctrine/SUBJECT_SELECTION.md SS-10,"
  echo "         doctrine/RETENTION.md RT-15"
  echo "  moves: fix the manifest, fixture or schema line named above; or run"
  echo "         python tools/validate_manifest.py --shape <path> for structure-only feedback,"
  echo "         which makes no conformance claim; then commit again."
  exit 1
}

# Step 12, rung 4. Every connector's adapter against its own cassettes and
# fixtures: the manifest gate first, every cassette replayed through parse and
# emit, every emitted event graded by tools/validate.py, event_count exact, each
# refusal fixture refused with its code, the known negative yielding no hit, and
# invoke() starting no process without a permit. It never runs a connector
# against a platform. It refuses whenever connectors/sherlock/manifest.yaml does.
python tools/validate_connector_conformance.py --all --quiet || {
  echo ""
  echo "pre-commit refused: a connector's adapter does not hold against its cassettes and fixtures."
  echo "  rule:  CONFORMANCE.md section 3 rung 4, docs/PLAINSIGHT-design.md sections 6.3 and 7.2,"
  echo "         doctrine/SUBJECT_SELECTION.md SS-6"
  echo "  moves: fix the adapter, fixture or cassette line named above; or, where the manifest"
  echo "         refusal is held on a reading, put it to the operator; then commit again."
  exit 1
}

# Every validator's self-test. Each breaks its governed artifact in memory and
# asserts that every break is refused, so a check that has stopped refusing is
# caught before the commit rather than read as green after it. The fires_when
# fix was reported green in two sessions while the layer-model self-test exited
# 1, because nothing on this path ran it. Unlike the Step 8 artifact modes named
# above, the eleven grade the checks rather than the stamps. All eleven are
# green today. The retention self-test refused with
# RETENTION_POLICY_ENFORCEMENT_MISSTATED from Step 12 until 2026-10-28, while
# policy/retention.yaml recorded the canary_subject_class part of RT-15 as
# absent and the Sherlock manifest declared it; that flag now reads present, a
# one-word edit made on the maintainer's instruction and decided Class B by him
# the same day, and the self-test's
# mutation for that part flips the flag rather than setting it.
# Two ratifying acts reach them anyway. Sealing the cast did, until the cast
# self-test was fixed on 2026-09-28 to construct its own seal state. Completing
# SS-14 item 6 still does: row 8 of conformance/gate/decisions.jsonl asserts the
# item 6 refusal from the real pin, so the authorization self-test's baseline
# stops being clean and the commit that completes the set edits that row too. A
# self-test's output is printed only when it refuses. The doctrine self-test and
# the self-test of tools/pin_of_record.py, the pin-of-record reader three gates
# share, joined on 2026-10-01. The divergence register's joined at Step 9, and
# the manifest validator's and the connector conformance runner's at Step 12.
for tool in validate_hygiene validate_layer_model validate_ontology validate_cast \
            validate_authorization validate_retention validate_doctrine pin_of_record \
            validate_divergence_register validate_manifest validate_connector_conformance; do
  out=$(python "tools/$tool.py" --self-test 2>&1) || {
    rc=$?
    printf '%s\n' "$out"
    echo ""
    echo "pre-commit refused: tools/$tool.py --self-test exited $rc."
    echo "  rule:  CLAUDE.md design gate 1, doctrine/HYGIENE.md section 2"
    echo "  what:  exit 1 means the self-test refused, for one of two reasons the output"
    echo "         above names: a deliberate break was not refused, so a clean run of that"
    echo "         validator no longer proves the check the break names; or the self-test's"
    echo "         baseline over the real artifacts is not clean, so it cannot tell a break"
    echo "         from the tree. Exit 2 means a governed input it loads could not be read."
    echo "  moves: fix the check that did not fire, or the mutation if it no longer produces"
    echo "         the defect it names; or fix the artifact or fixture row the baseline"
    echo "         names, in this commit; or restore the unreadable input; then commit again."
    exit 1
  }
done

python tools/validate_retention.py --repo-scan --staged || {
  echo ""
  echo "pre-commit refused: a staged file contains a selector-shaped string."
  echo "  rule:  AGENTS.md > Execution Limits, doctrine/RETENTION.md RT-15"
  echo "  moves: replace the value with a synthetic one from synthetic/CAST.md,"
  echo "         or classify the fixture as institutional in its manifest."
  exit 1
}
