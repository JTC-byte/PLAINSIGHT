# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Case material never reaches git. Git history is the one store a
# crypto-shred cannot reach, so these are ignored as a second line behind
# doctrine/RETENTION.md RT-15 rather than as a convenience.
cases/
*.case
results/
pulled/

# Gate telemetry. Untracked by design: a permanent record of tool behaviour is
# an archive, and this is telemetry with a 90 day TTL. doctrine/RETENTION.md RT-19.
.gate-log/

# Voice-pass survivor files. Working material for documentation edits, applied
# by tools outside the repository and never committed. The harvest lives in
# Z-ISR/_session-artifacts/2026-09-05-plainsight-voice-pass/.
_voice-pass/

# Local operator files. LOCAL_*.md is where the account and provisioning record
# lives, which carries mailbox addresses, account names and hardware identifiers
# that are operator identity rather than case material. EG-4 keeps that off a
# public tree.
.env
*.local.*
LOCAL_*.md

# Editor and OS residue
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local agent settings and merge or patch residue
.claude/
*.orig
*.rej
*.bak
