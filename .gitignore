# Case material never reaches git. Git history is the one store a
# crypto-shred cannot reach, so these are ignored as a second line behind
# doctrine/RETENTION.md RT-15 rather than as a convenience.
cases/
*.case
results/
pulled/

# Gate telemetry. Untracked by design: a permanent record of tool behaviour is
# an archive, and this is telemetry with a 90 day TTL. doctrine/RETENTION.md RT-19.
.gate-log/

# Local operator files
.env
*.local.*
