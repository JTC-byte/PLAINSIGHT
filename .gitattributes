# Line endings. The index holds LF and every checkout gets LF, so the
# validators, the pre-commit hook, and CI read the same bytes on every
# platform, and a Windows checkout stops producing CRLF churn in diffs.
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh text eol=lf
.githooks/* text eol=lf
*.bundle binary

# Connector cassettes are recorded bytes. Sherlock's CSV is CRLF-terminated and
# its Unknown line ends in a space, and the adapter is tested against both, so
# git stores and checks out a cassette unchanged and does not report those
# bytes as whitespace errors.
connectors/*/cassettes/** -text -whitespace
